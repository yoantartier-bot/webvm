FROM docker.io/i386/alpine:3.17

# Dépôts Alpine 3.17
RUN printf '%s\n' \
    'https://dl-cdn.alpinelinux.org/alpine/v3.17/main' \
    'https://dl-cdn.alpinelinux.org/alpine/v3.17/community' \
    > /etc/apk/repositories

# Linux graphique + Thonny
# PAS de LightDM : on démarre X directement.
RUN apk update && apk add --no-cache \
    alpine-base \
    eudev \
    udev-init-scripts \
    udev-init-scripts-openrc \
    dbus \
    xorg-server \
    xf86-input-libinput \
    xinit \
    i3wm \
    font-dejavu \
    bash \
    xterm \
    python3 \
    thonny

# Services nécessaires à WebVM / Xorg
RUN rc-update add bootmisc boot && \
    rc-update add udev sysinit && \
    rc-update add udev-trigger sysinit && \
    rc-update add udev-settle sysinit && \
    rc-update add udev-postmount default && \
    rc-update add dbus default

# Utilisateur de la session graphique
RUN adduser -D -s /bin/bash user && \
    echo 'user:password' | chpasswd

# Configuration i3 :
# Thonny se lance automatiquement.
# Alt+Entrée ouvre xterm si besoin.
RUN mkdir -p /home/user/.config/i3 && \
    printf 'set $mod Mod1\nfont pango:DejaVu Sans Mono 10\nexec --no-startup-id thonny\nbindsym $mod+Return exec xterm\n' \
    > /home/user/.config/i3/config && \
    chown -R user:user /home/user/.config

# Au démarrage de Linux :
# lancement automatique de Xorg + i3 sous l'utilisateur "user"
RUN mkdir -p /etc/local.d && \
    printf '#!/bin/sh\nsu - user -c "startx /usr/bin/i3 -- :0" >/tmp/thonny-desktop.log 2>&1 &\n' \
    > /etc/local.d/thonny.start && \
    chmod +x /etc/local.d/thonny.start && \
    rc-update add local default

CMD ["/bin/sh"]
