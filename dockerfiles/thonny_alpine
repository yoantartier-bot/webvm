FROM docker.io/i386/alpine:3.17

# Dépôts officiels Alpine 3.17.
# Thonny 3.3.14 se trouve dans "community".
RUN printf '%s\n' \
    'https://dl-cdn.alpinelinux.org/alpine/v3.17/main' \
    'https://dl-cdn.alpinelinux.org/alpine/v3.17/community' \
    > /etc/apk/repositories

# Bureau graphique + Python + véritable Thonny
RUN apk update && apk add --no-cache \
    alpine-base \
    eudev \
    udev-init-scripts \
    udev-init-scripts-openrc \
    dbus \
    xorg-server \
    xf86-input-libinput \
    lightdm \
    lightdm-gtk-greeter \
    i3wm \
    font-dejavu \
    xrandr \
    xev \
    bash \
    xterm \
    python3 \
    thonny

# Démarrage des services nécessaires au bureau
RUN rc-update add bootmisc boot && \
    rc-update add udev sysinit && \
    rc-update add udev-trigger sysinit && \
    rc-update add udev-settle sysinit && \
    rc-update add dbus default && \
    rc-update add lightdm default

# Utilisateur de la VM
RUN adduser -D -s /bin/bash user && \
    echo 'user:password' | chpasswd && \
    echo 'root:password' | chpasswd && \
    addgroup -S autologin && \
    addgroup user autologin

# Connexion automatique au bureau i3
RUN mkdir -p /etc/lightdm/lightdm.conf.d && \
    printf '[Seat:*]\nautologin-user=user\nautologin-user-timeout=0\nautologin-session=i3\nuser-session=i3\n' \
    > /etc/lightdm/lightdm.conf.d/50-autologin.conf
# Configuration i3 :
# - Thonny démarre automatiquement
# - Alt+Entrée ouvre un terminal de la VM
RUN mkdir -p /home/user/.config/i3 && \
    printf 'set $mod Mod1\nfont pango:DejaVu Sans Mono 10\nexec --no-startup-id thonny\nbindsym $mod+Return exec xterm\n' \
    > /home/user/.config/i3/config && \
    chown -R user:user /home/user/.config

CMD ["/bin/sh"]
